{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // One Worker serves the app (static build in dist/) and the published boards API under /api.
  "name": "versus",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "observability": { "enabled": true },
  // No routes on purpose: the custom domain is added in the dashboard, and deploys keep it.
  // Files are served before the Worker runs; the Worker gets what matches none (the API, the app's views, the
  // template pages, 404s), and the sitemap, which it completes with the template pages (docs/seo.md).
  "assets": { "directory": "../dist", "binding": "ASSETS", "run_worker_first": ["/sitemap.xml"] },
  "durable_objects": {
    "bindings": [{ "name": "BOARDS", "class_name": "BoardObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardObject"] }],
  // Board registry for the admin API. Wrangler creates the database on the first deploy.
  "d1_databases": [{ "binding": "REGISTRY", "database_name": "versus-registry", "migrations_dir": "migrations" }],
  // The cards a board's links unfurl with (uploaded by the app, served under /og/). `npm run worker:deploy`
  // creates the bucket when it is missing; the account's R2 must be enabled once in the dashboard.
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "versus-images" }],
  // Per-IP limits (the period is 10 or 60 seconds). A "Your votes" refresh wakes up to 24 boards: its own limit.
  "ratelimits": [
    { "name": "PUBLISH_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "API_LIMIT", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    { "name": "SUMMARY_LIMIT", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }
  ]
  // Secrets, set with `wrangler secret put`: ADMIN_TOKEN (admin API), TURNSTILE_SECRET (publication check).
}
