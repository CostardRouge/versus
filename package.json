{
  "name": "versus",
  "version": "0.1.0",
  "private": true,
  "description": "Rank anything by comparing two items at a time.",
  "license": "MIT",
  "author": "Steeve Pommier",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "worker:dev": "wrangler dev -c worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy -c worker/wrangler.jsonc"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/workers-types": "^5.20260929.1",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.2",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.144.0"
  }
}
