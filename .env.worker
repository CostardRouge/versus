# Build used by the Cloudflare Worker (npm run worker:dev / worker:deploy): the app and the API share
# one origin, so publishing talks to /api. The GitHub Pages build doesn't load this file.
VITE_API_URL=/
# Public Turnstile site key for deploys by hand (CI reads the TURNSTILE_SITE_KEY repository variable instead);
# the secret key goes to `wrangler secret put TURNSTILE_SECRET`.
# VITE_TURNSTILE_SITE_KEY=
